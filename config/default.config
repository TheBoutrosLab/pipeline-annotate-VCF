import nextflow.util.SysHelper
import nextflow.Nextflow

// Default inputs/parameters of the pipeline
params {
    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB

    ucla_cds = false

    docker_container_registry_uclahscds = "ghcr.io/uclahs-cds"
    docker_container_registry_theboutroslab = "ghcr.io/theboutroslab"

    SnpEff_version = "5.4.0c"
    GATK_version = "4.7.0.0"
    pipeval_version = "4.0.0-rc.2"
    samtools_version = "1.24"
    BCFtools_version = "1.24"
    VEP_version = "116.2"

    docker_image_samtools = "${-> params.docker_container_registry_theboutroslab}/samtools:${params.samtools_version}"
    docker_image_GATK = "broadinstitute/gatk:${params.GATK_version}"
    docker_image_validate = "${-> params.docker_container_registry_uclahscds}/pipeval:${params.pipeval_version}"
    docker_image_SnpEff = "${-> params.docker_container_registry_theboutroslab}/snpeff:${params.SnpEff_version}"
    docker_image_BCFtools = "${-> params.docker_container_registry_theboutroslab}/bcftools:${params.BCFtools_version}"
    docker_image_VEP = "${-> params.docker_container_registry_theboutroslab}/vep:${params.VEP_version}"

    // These parameters are inferred from the input files. The user can override them in the config file if required.
    reference_fasta_fai = "${-> params.reference_fasta}.fai"
    reference_fasta_dict = "${-> Nextflow.file(params.reference_fasta).resolveSibling(Nextflow.file(params.reference_fasta).getBaseName() + '.dict')}"
}

// Standard set of profiles
profiles {
    standard {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    apptainer {
        docker {
            enabled = false
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true

            runOptions = "--cleanenv"
        }

        params.container_mount_flag = "-B"
    }

    singularity {
        docker {
            enabled = false
        }

        apptainer {
            enabled = false
        }

        singularity {
            enabled = true

            autoMounts = true
            ociAutoPull = true

            runOptions = "--cleanenv"
        }

        params.container_mount_flag = "-B"
    }
}

// Process specific scope
process {
    // Process results are stored to local cache.
    // If pipeline is launched with the 'resume' option, existing cache results will be used when available
    // rather than re-executing processes
    cache = true

    // Forward process 'stdout' to shell terminal and, consequently, the log file
    debug = false
    executor = 'local'

    // Other directives or options that should apply for every process

    // Default set of resources for processes if no process- or label-specific allocations are defined for a process
    cpus = params.max_cpus
    memory = params.max_memory
}
