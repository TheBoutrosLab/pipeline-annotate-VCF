// EXECUTION SETTINGS AND GLOBAL DEFAULTS

// External config files import. DO NOT MODIFY THESE LINES!
includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

/**
*   Pipeline parameters
*/

params {
    dataset_id = ''

    algorithm = ['SnpEff', 'Funcotator'] //'SnpEff', 'VEP', 'Funcotator'

    // Genome version for SnpEff database version
    genome_version = 'hg38'

    save_intermediate_files = false

    output_dir = '/path/to/output/dir'

    // BCFtools Options
    skip_normalization = false // if you want to skip the vcf normalization process
    //`bcftools_norm_options` and `bcftools_view_options` can be skipped using `skip_normalization = true`
    // When `skip_normalization = false`:
    // if the `bcftools_view_options` is empty, default view filtering argument is "--trim-alt-alleles"
    // if the `bcftools_norm_options` is empty, default normalization argument is "-a -m +any"
    // Note: ` -O z -o ${output_filename}.vcf.gz`, is fixed in the pipleine.
    bcftools_view_options = ''
    bcftools_norm_options = ''

    // SnpEFF Options
    SnpEff_data_dir = '/path/to/SnpEff/data/'
    SnpEff_download = false // default is false, so SnpEff will use the downloaded dataset from params.SnpEff_data_dir.
    SnpSift_annotate_database = ['/path/to/clinvar_20230722.vcf.gz', '/path/to/AlphaMissense_hg38_converted.vcf.gz']
    skip_SnpEff = false // false, true. Default is false.

    // Funcotator Options
    reference = '/path/to/Homo_sapiens_assembly38.fasta'
    Funcotator_data_source = '/path/to/Funcotator/somatic/funcotator_dataSources.v1.7.20200521s'
    Funcotator_output_format = 'VCF' // 'VCF', or 'MAF'
    // whether use option '--force-b37-to-hg19-reference-contig-conversion'
    Funcotator_b37_to_hg19_conversion = false // false, true. Default is false.
    // extra options for Funcotator, such as '--ignore-filtered-variants false'
    Funcotator_extra_options = ''

    command_mem_diff = 500.MB

    // VEP Options
    vep_cache = '/path/to/VEP-116.2/GRCh38-EBI-ENSEMBL101'
    chromosomes = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM'
    genome_assembly_version = 'GRCh38'
    genome_annotation_version = 'GENCODEv34'
    genome_fasta = '/path/to/GRCh38-EBI-GENCODE34/GRCh38.p13.genome.fa'
    annotation_gtf = '/path/to/GRCh38-EBI-GENCODE34/gencode.v34.chr_patch_hapl_scaff.annotation.sorted.gtf.gz'
}

// Setup the pipeline config. DO NOT REMOVE THIS LINE!
methods.setup()
